      "source": [
        "# Lag between discharge and billing month / Defasagem entre alta e competência\n",
        "query = \"\"\"\n",
        "WITH base AS (\n",
        "    SELECT\n",
        "        try_strptime(DT_SAIDA, '%Y%m%d')::DATE AS dt_saida,\n",
        "        make_date(CAST(ANO_CMPT AS INTEGER), CAST(MES_CMPT AS INTEGER), 1) AS competencia\n",
        "    FROM rd_raw\n",
        ")\n",
        "SELECT\n",
        "    date_diff('month', date_trunc('month', dt_saida), competencia) AS lag_meses,\n",
        "    COUNT(*) AS n_aih,\n",
        "    ROUND(100.0 * COUNT(*) / SUM(COUNT(*)) OVER (), 2) AS pct\n",
        "FROM base\n",
        "GROUP BY lag_meses\n",
        "ORDER BY lag_meses\n",
        "\"\"\"\n",
        "duckdb.sql(query).show()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "Wnc1lJ0TGDZb"
      },
      "outputs": [],
      "source": [
        "# EN: Run the window check through DuckDB (SQL goes inside a Python string)\n",
        "# PT: Roda a checagem do recorte via DuckDB (o SQL vai dentro de uma string Python)\n",
        "query = \"\"\"\n",
        "SELECT\n",
        "    CASE\n",
        "        WHEN dt_saida_date IS NULL THEN 'invalid_date'\n",
        "        WHEN dt_saida_date BETWEEN DATE '2023-01-01' AND DATE '2025-09-30' THEN 'inside'\n",
        "        ELSE 'outside'\n",
        "    END AS window_status,\n",
        "    COUNT(*) AS n_aih,\n",
        "    ROUND(100.0 * COUNT(*) / SUM(COUNT(*)) OVER (), 2) AS pct\n",
        "FROM (\n",
        "    -- EN: TRY_STRPTIME returns NULL instead of failing on a bad date\n",
        "    -- PT: TRY_STRPTIME devolve NULL em vez de dar erro numa data inválida\n",
        "    SELECT TRY_STRPTIME(DT_SAIDA, '%Y%m%d')::DATE AS dt_saida_date\n",
        "    FROM rd_raw\n",
        ")\n",
        "GROUP BY window_status\n",
        "ORDER BY n_aih DESC\n",
        "\"\"\"\n",
        "\n",
        "duckdb.sql(query).show()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "jvUPHC6DGuou"
      },
      "outputs": [],
      "source": [
        "# EN: Break down the 'outside' rows by discharge month\n",
        "# PT: Abre as linhas 'outside' por mês de saída\n",
        "query = \"\"\"\n",
        "SELECT\n",
        "    STRFTIME(dt_saida_date, '%Y-%m') AS discharge_month,\n",
        "    COUNT(*) AS n_aih\n",
        "FROM (\n",
        "    SELECT TRY_STRPTIME(DT_SAIDA, '%Y%m%d')::DATE AS dt_saida_date\n",
        "    FROM rd_raw\n",
        ")\n",
        "WHERE dt_saida_date NOT BETWEEN DATE '2023-01-01' AND DATE '2025-09-30'\n",
        "GROUP BY discharge_month\n",
        "ORDER BY discharge_month\n",
        "\"\"\"\n",
        "\n",
        "duckdb.sql(query).show()"
      ]
    },
    {
