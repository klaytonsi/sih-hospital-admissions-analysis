    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "hxezW5PHtuW5"
      },
      "outputs": [],
      "source": [
        "# Residual check: dif - (GES + FED), in R$ millions\n",
        "# Checagem do resíduo: dif - (GES + FED), em milhões de R$\n",
        "duckdb.sql(f\"\"\"\n",
        "WITH mensal AS (\n",
        "    SELECT\n",
        "        ANO_CMPT AS ano, MES_CMPT AS mes,\n",
        "        SUM(TRY_CAST(VAL_TOT AS DOUBLE))\n",
        "          - SUM(TRY_CAST(VAL_SH AS DOUBLE))\n",
        "          - SUM(TRY_CAST(VAL_SP AS DOUBLE))        AS dif,\n",
        "        SUM(TRY_CAST(VAL_SH_GES AS DOUBLE))\n",
        "          + SUM(TRY_CAST(VAL_SP_GES AS DOUBLE))    AS ges,\n",
        "        SUM(TRY_CAST(VAL_SH_FED AS DOUBLE))\n",
        "          + SUM(TRY_CAST(VAL_SP_FED AS DOUBLE))    AS fed\n",
        "    FROM read_parquet('{PASTA_PARQUET}/RDRJ*.parquet', union_by_name=true)\n",
        "    GROUP BY ANO_CMPT, MES_CMPT\n",
        ")\n",
        "SELECT\n",
        "    ano, mes,\n",
        "    ROUND(dif / 1e6, 2)                          AS dif,\n",
        "    ROUND((ges + fed) / 1e6, 2)                  AS ges_mais_fed,\n",
        "    ROUND((dif - ges - fed) / 1e6, 2)            AS residuo,\n",
        "    ROUND(100 * (dif - ges - fed) / NULLIF(dif, 0), 1) AS residuo_pct\n",
        "FROM mensal\n",
        "ORDER BY ano, mes\n",
        "\"\"\").show(max_rows=40)"
      ]
