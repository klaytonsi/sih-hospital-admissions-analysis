      "source": [
        "# Testa se VAL_TOT = soma dos componentes / Test if VAL_TOT = sum of components\n",
        "duckdb.sql(f\"\"\"\n",
        "    SELECT\n",
        "        COUNT(*) AS total_linhas,\n",
        "        SUM(CASE WHEN ABS(soma_a - val_tot) < 0.01 THEN 1 ELSE 0 END) AS bate_a,\n",
        "        SUM(CASE WHEN ABS(soma_b - val_tot) < 0.01 THEN 1 ELSE 0 END) AS bate_b\n",
        "    FROM (\n",
        "        SELECT\n",
        "            TRY_CAST(VAL_TOT AS DOUBLE) AS val_tot,\n",
        "            -- Hipótese A / Hypothesis A\n",
        "            COALESCE(TRY_CAST(VAL_SH AS DOUBLE),0)\n",
        "              + COALESCE(TRY_CAST(VAL_SP AS DOUBLE),0) AS soma_a,\n",
        "            -- Hipótese B: complete você / Hypothesis B: you complete\n",
        "            COALESCE(TRY_CAST(VAL_SH AS DOUBLE),0)\n",
        "              + COALESCE(TRY_CAST(VAL_SP AS DOUBLE),0)\n",
        "              + COALESCE(TRY_CAST(VAL_SADT AS DOUBLE),0)\n",
        "              -- + ... demais componentes / other components\n",
        "              AS soma_b\n",
        "        FROM '{PASTA_PARQUET}/RDRJ2301.parquet'\n",
        "    )\n",
        "\"\"\").show()"
      ]
    },
