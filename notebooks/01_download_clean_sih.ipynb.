      "source": [
        "from pysus import sih\n",
        "\n",
        "caminhos_baixados = []\n",
        "\n",
        "for ano in range(2023, 2026):\n",
        "    arquivos = sih(\n",
        "        state=\"RJ\",\n",
        "        year=ano,\n",
        "        month=list(range(1, 13)),  # jan a dez\n",
        "        group=\"RD\",\n",
        "        as_dataframe=False,  # queremos os caminhos, não já concatenar tudo em memória\n",
        "    )\n",
        "    caminhos_baixados.extend(arquivos)\n",
        "    print(f\"{ano}: {len(arquivos)} arquivos baixados\")"
      ]
    },
