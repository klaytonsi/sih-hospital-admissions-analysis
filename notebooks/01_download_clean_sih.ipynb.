        "id": "ax0e8W3nnE69"
      },
      "outputs": [],
      "source": [
        "import re\n",
        "\n",
        "meses_por_ano = {}\n",
        "for caminho in caminhos_baixados:\n",
        "    nome = caminho.split(\"/\")[-1]  # ex: RDRJ2303.parquet\n",
        "    match = re.search(r\"RDRJ(\\d{2})(\\d{2})\\.parquet\", nome)\n",
        "    if match:\n",
        "        ano = \"20\" + match.group(1)\n",
        "        mes = match.group(2)\n",
        "        meses_por_ano.setdefault(ano, []).append(mes)\n",
        "\n",
        "for ano, meses in sorted(meses_por_ano.items()):\n",
        "    faltando = [f\"{m:02d}\" for m in range(1, 13) if f\"{m:02d}\" not in meses]\n",
        "    print(f\"{ano}: {sorted(meses)} — faltando: {faltando}\")"
      ]
    },
