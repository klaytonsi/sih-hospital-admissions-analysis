        "# EN: Check if VAL_UTI is already inside VAL_SH + VAL_SP\n",
        "# PT: Confere se o VAL_UTI já está dentro de VAL_SH + VAL_SP\n",
        "duckdb.sql(\"\"\"\n",
        "SELECT\n",
        "    COUNT(*) AS linhas,\n",
        "    -- EN: rows with UTI value / PT: linhas com valor de UTI\n",
        "    COUNT(*) FILTER (WHERE TRY_CAST(VAL_UTI AS DOUBLE) > 0) AS com_uti,\n",
        "    -- EN: rows where UTI > SH+SP (UTI would NOT be contained)\n",
        "    -- PT: linhas em que UTI > SH+SP (UTI NÃO estaria contido)\n",
        "    COUNT(*) FILTER (\n",
        "        WHERE TRY_CAST(VAL_UTI AS DOUBLE)\n",
        "            > TRY_CAST(VAL_SH AS DOUBLE) + TRY_CAST(VAL_SP AS DOUBLE)\n",
        "    ) AS uti_maior_que_sh_sp,\n",
        "    -- EN: rows where SH+SP+UTI > val_tot (UTI would be extra)\n",
        "    -- PT: linhas em que SH+SP+UTI > val_tot (UTI seria extra)\n",
        "    COUNT(*) FILTER (\n",
        "        WHERE TRY_CAST(VAL_SH AS DOUBLE) + TRY_CAST(VAL_SP AS DOUBLE)\n",
        "            + TRY_CAST(VAL_UTI AS DOUBLE)\n",
        "            > val_tot + 0.01\n",
        "    ) AS soma_estoura_total\n",
        "FROM rd_clean\n",
        "\"\"\").show()"
