      "source": [
        "# EN: Q1 - Spending by component, by discharge month (all rows, per project rule)\n",
        "# PT: P1 - Gasto por componente, por mês de saída (todas as linhas, regra do projeto)\n",
        "duckdb.sql(\"\"\"\n",
        "WITH mensal AS (\n",
        "    SELECT\n",
        "        DATE_TRUNC('month', dt_saida)::DATE AS mes_saida,\n",
        "        SUM(TRY_CAST(VAL_SH AS DOUBLE))     AS val_sh,\n",
        "        SUM(TRY_CAST(VAL_SP AS DOUBLE))     AS val_sp,\n",
        "        -- EN: federal + manager supplements / PT: complementos federal + gestor\n",
        "        SUM(TRY_CAST(VAL_SH_FED AS DOUBLE) + TRY_CAST(VAL_SP_FED AS DOUBLE)\n",
        "          + TRY_CAST(VAL_SH_GES AS DOUBLE) + TRY_CAST(VAL_SP_GES AS DOUBLE)) AS val_compl,\n",
        "        -- EN: ICU is INSIDE SH+SP (do not add) / PT: UTI está DENTRO de SH+SP (não somar)\n",
        "        SUM(TRY_CAST(VAL_UTI AS DOUBLE))    AS val_uti_dos_quais,\n",
        "        SUM(val_tot)                        AS val_total\n",
        "    FROM rd_clean\n",
        "    GROUP BY 1\n",
        ")\n",
        "SELECT\n",
        "    mes_saida,\n",
        "    ROUND(val_sh / 1e6, 2)    AS sh_mi,\n",
        "    ROUND(val_sp / 1e6, 2)    AS sp_mi,\n",
        "    ROUND(val_compl / 1e6, 2) AS compl_mi,\n",
        "    ROUND(val_total / 1e6, 2) AS total_mi,\n",
        "    ROUND(val_uti_dos_quais / 1e6, 2) AS uti_dos_quais_mi,\n",
        "    -- EN: validation, must be ~0 / PT: validação, deve ser ~0\n",
        "    ROUND(val_total - val_sh - val_sp - val_compl, 2) AS residuo\n",
        "FROM mensal\n",
        "ORDER BY mes_saida\n",
        "\"\"\").show(max_rows=40)"
