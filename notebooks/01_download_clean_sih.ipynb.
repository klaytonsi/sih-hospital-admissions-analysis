      "source": [
        "# Diferença TOT - (SH+SP) por mês, em % / Gap TOT - (SH+SP) per month, in %\n",
        "duckdb.sql(f\"\"\"\n",
        "    SELECT\n",
        "        ANO_CMPT, MES_CMPT,\n",
        "        COUNT(*) AS linhas,\n",
        "        ROUND(SUM(TRY_CAST(VAL_TOT AS DOUBLE))\n",
        "            - SUM(TRY_CAST(VAL_SH AS DOUBLE))\n",
        "            - SUM(TRY_CAST(VAL_SP AS DOUBLE)), 2) AS diferenca,\n",
        "        ROUND(100 * (SUM(TRY_CAST(VAL_TOT AS DOUBLE))\n",
        "            - SUM(TRY_CAST(VAL_SH AS DOUBLE))\n",
        "            - SUM(TRY_CAST(VAL_SP AS DOUBLE)))\n",
        "            / SUM(TRY_CAST(VAL_TOT AS DOUBLE)), 2) AS pct_diferenca\n",
        "    FROM read_parquet('{PASTA_PARQUET}/RDRJ*.parquet', union_by_name=true)\n",
        "    GROUP BY ANO_CMPT, MES_CMPT\n",
        "    ORDER BY ANO_CMPT, MES_CMPT\n",
        "\"\"\").show(max_rows=40)"
      ]
