      "outputs": [],
      "source": [
        "# EN: Profile VAL_TOT before casting (empty, invalid, comma decimal)\n",
        "# PT: Perfila o VAL_TOT antes de converter (vazio, inválido, vírgula decimal)\n",
        "query = \"\"\"\n",
        "SELECT\n",
        "    CASE\n",
        "        WHEN VAL_TOT IS NULL OR TRIM(VAL_TOT) = '' THEN 'empty_or_null'\n",
        "        WHEN VAL_TOT LIKE '%,%'                    THEN 'has_comma'\n",
        "        WHEN TRY_CAST(VAL_TOT AS DOUBLE) IS NULL   THEN 'not_numeric'\n",
        "        ELSE 'numeric_ok'\n",
        "    END AS val_tot_status,\n",
        "    COUNT(*) AS n_aih,\n",
        "    ROUND(100.0 * COUNT(*) / SUM(COUNT(*)) OVER (), 2) AS pct\n",
        "FROM rd_raw\n",
        "GROUP BY val_tot_status\n",
        "ORDER BY n_aih DESC\n",
        "\"\"\"\n",
        "\n",
        "duckdb.sql(query).show()"
      ]
    },
